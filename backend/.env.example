APP_NAME=VE-JIT Platform
APP_VERSION=4.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=2
STORE_ID=store_001
STORE_NAME=Demo Store
STORE_TIMEZONE=America/New_York
QUEUE_TARGET_WAIT_SECONDS=180
QUEUE_MAX_WAIT_SECONDS=300
QUEUE_ALERT_COOLDOWN_SECONDS=300
QUEUE_AVG_ORDER_VALUE=45.0
QUEUE_SAFETY_BUFFER=1.15
QUEUE_POLL_INTERVAL_SECONDS=30
DATABASE_URL=sqlite:///./vejit.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Set for PostgreSQL-backed deployments (install requirements-postgres.txt); never for skills
# CLOUD sync (empty = honest dry-run outbox drain). Token required only if the URL is set.
CLOUD_SYNC_URL=
# CLOUD_SYNC_TOKEN=
# Hard safety gate: max age of the newest active policy rule before actions are DENIED (0 disables)
POLICY_BUNDLE_MAX_AGE_SECONDS=86400
TENANT_ID=tenant_001
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_QUEUE_METRICS=queue-metrics
KAFKA_TOPIC_QUEUE_ALERTS=queue-alerts
SENSOR_API_URL=http://localhost:8001
SENSOR_API_TIMEOUT=5
SENSOR_API_RETRY_COUNT=3
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*
