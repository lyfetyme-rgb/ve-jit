{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "history"
  ],
  "properties": {
    "history": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "method": {
      "type": "string",
      "enum": [
        "ses",
        "sma"
      ]
    },
    "alpha": {
      "type": "number"
    },
    "window": {
      "type": "integer",
      "minimum": 1
    }
  }
}
